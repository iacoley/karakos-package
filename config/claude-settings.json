{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [],
    "deny": []
  },
  "env": {},
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$WORKSPACE_ROOT/system/hooks/log-user-prompt.sh"
          },
          {
            "type": "command",
            "command": "$WORKSPACE_ROOT/system/hooks/inject-recall.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Read",
        "hooks": [
          {
            "type": "command",
            "command": "$WORKSPACE_ROOT/system/hooks/resolve-symlink-edit.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$WORKSPACE_ROOT/system/hooks/protected-paths-edit.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$WORKSPACE_ROOT/system/hooks/bash-safety-rails.py"
          },
          {
            "type": "command",
            "command": "$WORKSPACE_ROOT/system/hooks/block-bare-ssh.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$WORKSPACE_ROOT/system/hooks/stop-deferred-work.py"
          }
        ]
      }
    ]
  }
}
