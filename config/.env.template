# Karakos System Configuration
# Generated by setup.sh — NEVER commit this file to git
# File permissions: 600 (owner read/write only)

# === Model backend ===
# "claude" (default) drives the Claude Code CLI; "ollama" routes the builder,
# reviewer, session summarizer, and memory importance scorer through the
# minimal native runner (bin/ollama_runner.py) against a local Ollama server.
# The always-on conversational agents (primary/relay) still use Claude.
AGENT_BACKEND=claude
OLLAMA_HOST=http://host.docker.internal:11434   # Ollama server base URL (host.docker.internal reaches the host from the container)
OLLAMA_MODEL=llama3.1                            # Default model tag for local sessions
# OLLAMA_TIMEOUT=300                             # Per-request HTTP timeout (seconds)

# === Anthropic Auth ===
# Handled by 'claude login' — no API key needed in this file (unless AGENT_BACKEND=ollama)

# === Agent Server ===
AGENT_SERVER_TOKEN=krkos_...          # Auto-generated bearer token for internal API auth

# === Dashboard ===
SESSION_SECRET=...                    # Auto-generated HMAC key for session tokens
DASHBOARD_PASSWORD=...                # Auto-generated, displayed during setup

# === Discord — per-agent bot tokens ===
# At minimum, configure the primary agent's bot
DISCORD_BOT_TOKEN_PRIMARY=MTIz...
DISCORD_BOT_ID_PRIMARY=1234567890123456
# DISCORD_BOT_TOKEN_RELAY=NTY4...    # Optional — falls back to primary
# DISCORD_BOT_ID_RELAY=2345678901234567
DISCORD_SERVER_ID=1234567889

# === Discord channels ===
DISCORD_CHANNEL_GENERAL=1234567890
DISCORD_CHANNEL_SIGNALS=1234567891

# === System identity ===
SYSTEM_NAME=Karakos
OWNER_NAME=User
OWNER_DISCORD_ID=0
WORKSPACE_ROOT=/workspace

# === Network ===
DASHBOARD_PORT=3000
AGENT_SERVER_PORT=18791
TZ=America/Los_Angeles

# === Cost limits ===
COST_DAILY_LIMIT=25.00
COST_MONTHLY_LIMIT=500.00
COST_WARNING_THRESHOLD=0.75

# === Concurrency ===
MAX_CONCURRENT_BUILDERS=1
MAX_CONCURRENT_REVIEWERS=2

# === Memory tuning ===
MEMORY_DECAY_RATE=0.25
MEMORY_CUTOFF=6.0
MEMORY_MAX_EPISODES=15

# === Gmail Webhook (optional — requires GCP Pub/Sub setup) ===
# GMAIL_WEBHOOK_SECRET=...            # Pre-shared token for Pub/Sub push auth

# === Retention ===
MESSAGE_RETENTION_DAYS=90
TOOL_AUDIT_RETENTION_DAYS=30
