#!/usr/bin/env python3
"""buildq -- operate the build queue (spec 3.3).

  buildq enqueue --kind build|review --repo owner/name --target-branch B
                 [--brief-file F | --text T] [--origin human|machine]
                 [--priority N] [--host H] [--requester AGENT]
  buildq list [--status S] [--json]      buildq show ID      buildq cancel ID
  buildq requeue ID    buildq hosts    buildq ingest
  buildq doctor [--json]               buildq enable [--no-agents]

Opens data/build-queue.db directly (WAL), so it works whether or not the
dispatcher is running. Refuses while config/build-queue.yaml says
`enabled: false` unless --force (briefs dropped in the inbox keep working in that
state through the relay's own adapter). `doctor` (read-only) lists what a build
needs; `enable` switches the queue on and creates the builder and reviewer
agents unless --no-agents. Both run while the queue is disabled.
"""
import argparse
import json
import os
import sys as _sys
_sys.path.insert(0, os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)), "../lib")))
from paths import workspace_root  # noqa: E402
import re
import shutil
import sqlite3
import subprocess
import sys
from pathlib import Path

import yaml

PKG = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(PKG / "lib"))

import build_hosts  # noqa: E402
import buildq  # noqa: E402

CREATE_AGENT = Path(__file__).resolve().parent / "create-agent.sh"
BUILD_QUEUE_YAML = """\
# Build queue. `bin/buildq doctor` checks what it needs.
enabled: true
default_host: local
hosts:
  local:
    kind: local
    concurrency: 1
retry:
  max_attempts: 1
"""
AGENT_ROLES = (  # (role, template, model, agent name) used by `enable`
    ("builder", "builder", "haiku", "builder"),
    ("reviewer", "reviewer", "sonnet", "reviewer"),
)


def die(msg, code=1):
    print(f"buildq: {msg}", file=sys.stderr)
    return code


# --- doctor / enable (work while the queue is disabled) --------------------

def _check(name, ok, detail):
    return {"name": name, "ok": bool(ok), "detail": detail}


def _agent_ids(ws, role):
    """Agent ids in config/agents.yaml with `role: <role>`. Raises OSError or
    yaml.YAMLError when the file is unreadable."""
    path = ws / "config" / "agents.yaml"
    if not path.is_file():
        return []
    data = yaml.safe_load(path.read_text()) or {}
    agents = data.get("agents") if isinstance(data, dict) else None
    if not isinstance(agents, dict):
        return []
    return [str(aid) for aid, body in agents.items()
            if isinstance(body, dict) and body.get("role") == role]


def _role_check(ws, role, name):
    try:
        ids = _agent_ids(ws, role)
    except (OSError, yaml.YAMLError) as e:
        return _check(name, False, f"config/agents.yaml unreadable: {e}")
    if ids:
        return _check(name, True, ", ".join(ids))
    return _check(name, False, "none: run `buildq enable`")


def _config_check(ws):
    path = ws / "config" / "build-queue.yaml"
    cfg = build_hosts.load_config(path)
    if cfg.invalid:
        return _check("config", False, f"invalid: {cfg.invalid}"), cfg
    note = "" if path.is_file() else " (no build-queue.yaml; built-in defaults)"
    return _check("config", True, f"enabled: {'true' if cfg.enabled else 'false'}{note}"), cfg


def _database_check(ws):
    db = ws / "data" / "build-queue.db"
    if not db.is_file():
        return _check("database", False, "data/build-queue.db missing: run karakos migrate")
    try:
        # Read-only: a plain connect would create the file or switch it to WAL.
        conn = sqlite3.connect(db.as_uri() + "?mode=ro", uri=True)
        try:
            present = buildq.tables_present(conn)
        finally:
            conn.close()
    except sqlite3.Error as e:
        return _check("database", False, f"cannot open: {e}")
    return _check("database", present, "build queue tables present" if present
                  else "build queue tables missing: run karakos migrate")


def _tool_on_host(hc, tool):
    """-> (found, detail). The binary for `claude_cli` is `claude`."""
    if hc.kind == "ssh":
        if not hc.target:
            return False, "ssh host has no target"
        try:
            p = subprocess.run(build_hosts.ssh_argv(hc.target, f"command -v {tool}"),
                               capture_output=True, text=True, timeout=10,
                               stdin=subprocess.DEVNULL)
        except (subprocess.TimeoutExpired, OSError) as e:
            return False, f"ssh {hc.target}: {type(e).__name__}"
        if p.returncode == 0 and p.stdout.strip():
            return True, p.stdout.strip()
        return False, f"{tool} not found on {hc.target}"
    path = shutil.which(tool)
    return (True, path) if path else (False, f"{tool} not found")


def _host_checks(cfg):
    out = []
    for name, hc in sorted(cfg.hosts.items()):
        for label, tool in (("claude_cli", "claude"), ("git", "git"), ("gh", "gh")):
            ok, detail = _tool_on_host(hc, tool)
            out.append(_check(f"{label}@{name}", ok, detail))
    return out


def _github_auth_check(cfg):
    for var in ("GH_TOKEN", "GITHUB_TOKEN"):
        if os.environ.get(var):
            return _check("github_auth", True, f"{var} set")
    if "local" not in cfg.hosts:
        return _check("github_auth", False, "no GH_TOKEN/GITHUB_TOKEN; no local host to run gh auth status")
    if not shutil.which("gh"):
        return _check("github_auth", False, "no GH_TOKEN/GITHUB_TOKEN; gh not found, gh auth status not run")
    try:
        p = subprocess.run(["gh", "auth", "status"], capture_output=True, text=True,
                           timeout=10, stdin=subprocess.DEVNULL)
    except (subprocess.TimeoutExpired, OSError) as e:
        return _check("github_auth", False, f"gh auth status: {type(e).__name__}")
    if p.returncode == 0:
        return _check("github_auth", True, "gh auth status ok")
    return _check("github_auth", False,
                  "no GH_TOKEN/GITHUB_TOKEN and gh auth status failed: set GH_TOKEN in config/.env or run gh auth login")


def doctor_checks(ws):
    config, cfg = _config_check(ws)
    checks = [config, _database_check(ws),
              _role_check(ws, "builder", "builder_agent"),
              _role_check(ws, "reviewer", "reviewer_agent")]
    checks += _host_checks(cfg)
    checks.append(_github_auth_check(cfg))
    return checks


def _print_checks(checks):
    for c in checks:
        print(f"{'PASS' if c['ok'] else 'FAIL'} {c['name']}  {c['detail']}")
    failing = sum(1 for c in checks if not c["ok"])
    print(f"doctor: {failing} failing")
    return 0 if not failing else 1


def cmd_doctor(ws, as_json):
    checks = doctor_checks(ws)
    if as_json:
        print(json.dumps(checks))
        return 0 if all(c["ok"] for c in checks) else 1
    return _print_checks(checks)


def _enable_config(path):
    if not path.exists():
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(BUILD_QUEUE_YAML)
        return "wrote"
    text = path.read_text()
    if re.search(r"(?m)^enabled:", text):
        # Replace only the value; the rest of the line (a trailing comment) and
        # every other line stay as they are.
        new = re.sub(r"(?m)^enabled:(?:[^\S\n]+[^\s#]+)?", "enabled: true", text, count=1)
    else:
        new = "enabled: true\n" + text
    path.write_text(new)
    return "updated"


def cmd_enable(ws, no_agents):
    path = ws / "config" / "build-queue.yaml"
    print(f"{_enable_config(path)} {path}")
    if not no_agents:
        for role, template, model, name in AGENT_ROLES:
            try:
                present = _agent_ids(ws, role)
            except (OSError, yaml.YAMLError) as e:
                print(f"skip {name}: config/agents.yaml unreadable: {e}")
                continue
            if present:
                print(f"{role} agent present: {', '.join(present)}")
                continue
            sys.stdout.flush()  # keep our lines in order with create-agent.sh's output
            r = subprocess.run(["bash", str(CREATE_AGENT), "--template", template,
                                "--model", model, name],
                               env={**os.environ, "WORKSPACE_ROOT": str(ws)})
            if r.returncode:
                print(f"create {name} failed (exit {r.returncode}); the doctor will report it")
    print()
    rc = cmd_doctor(ws, as_json=False)
    print("Restart to apply: docker compose restart (or bin/karakos restart)")
    return rc


def _row(r):
    d = dict(r)
    for k in ("run_ref", "result"):
        if d.get(k):
            try:
                d[k] = json.loads(d[k])
            except ValueError:
                pass
    return d


def _line(r):
    return f"{r['id']}  {r['status']:<9} {r['kind']:<6} {r['origin']:<7} p{r['priority'] or 0}  " \
           f"{r['repo'] or '-'}  {r['exec_host'] or r['host'] or '-'}  {r['reason'] or ''}".rstrip()


def _compose(brief, flags):
    meta = buildq.parse_frontmatter(brief)
    add = [f"{k}: {v}" for k, v in flags if v and k not in meta]
    if not add:
        return brief
    if brief.startswith("---"):
        head, _, rest = brief.partition("\n")
        return head + "\n" + "\n".join(add) + "\n" + rest
    return "---\n" + "\n".join(add) + "\n---\n" + brief


def main(argv=None):
    ap = argparse.ArgumentParser(prog="buildq")
    ap.add_argument("--workspace", default=workspace_root())
    ap.add_argument("--force", action="store_true", help="run even when the queue is disabled")
    ap.add_argument("--json", action="store_true", dest="as_json")
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", dest="as_json", default=argparse.SUPPRESS)
    common.add_argument("--force", action="store_true", default=argparse.SUPPRESS)
    sub = ap.add_subparsers(dest="cmd", required=True)
    e = sub.add_parser("enqueue", parents=[common])
    e.add_argument("--kind", required=True, choices=buildq.KINDS)
    e.add_argument("--repo")
    e.add_argument("--target-branch")
    e.add_argument("--brief-file")
    e.add_argument("--text")
    e.add_argument("--origin", default="human", choices=buildq.ORIGINS)
    e.add_argument("--priority", type=int, default=0)
    e.add_argument("--host")
    e.add_argument("--requester")
    ls = sub.add_parser("list", parents=[common])
    ls.add_argument("--status", choices=buildq.STATUSES)
    ls.add_argument("--limit", type=int, default=100)
    for n in ("show", "cancel", "requeue"):
        sub.add_parser(n, parents=[common]).add_argument("id")
    sub.add_parser("hosts", parents=[common])
    sub.add_parser("ingest", parents=[common])
    sub.add_parser("doctor", parents=[common])
    en = sub.add_parser("enable")
    en.add_argument("--no-agents", action="store_true", help="only switch the queue on")
    args = ap.parse_args(argv)
    ws = Path(args.workspace)
    # Both work while the queue is disabled and whatever the config says.
    if args.cmd == "doctor":
        return cmd_doctor(ws, args.as_json)
    if args.cmd == "enable":
        return cmd_enable(ws, args.no_agents)
    cfg = build_hosts.load_config(ws / "config" / "build-queue.yaml")
    if cfg.invalid:
        return die(f"invalid config: {cfg.invalid}")
    if not cfg.enabled and not args.force:
        return die("the build queue is disabled (config/build-queue.yaml: enabled: false); "
                   "briefs in inbox/ still run through the relay. Use --force to operate it anyway.")
    db = ws / "data" / "build-queue.db"
    if not db.is_file():
        return die("no build queue database; run karakos migrate")
    conn = buildq.connect(db)
    if not buildq.tables_present(conn):
        return die("build queue tables are missing; run karakos migrate")
    now = None

    if args.cmd == "enqueue":
        if args.brief_file:
            body = Path(args.brief_file).read_text()
        elif args.text:
            body = args.text
        else:
            return die("give --brief-file or --text")
        if args.host and args.host not in cfg.hosts:
            return die(f"unknown host {args.host!r}; configured: {', '.join(sorted(cfg.hosts))}")
        brief = _compose(body, [("repo", args.repo), ("target_branch", args.target_branch),
                                ("requester", args.requester)])
        try:
            import registry
            reg = registry.load_registry(ws)
            qid = buildq.enqueue(conn, args.kind, brief, args.repo, args.target_branch,
                                 args.requester, None, args.origin, "cli", args.priority,
                                 args.host, registry=reg)
        except buildq.BriefError as ex:
            return die(f"refused: {ex}")
        out = {"id": qid, "status": "queued"}
        print(json.dumps(out) if args.as_json else f"queued {qid}")
        return 0
    if args.cmd == "list":
        rows = buildq.list_rows(conn, args.status, args.limit)
        if args.as_json:
            print(json.dumps([_row(r) for r in rows]))
        else:
            for r in rows:
                print(_line(r))
        return 0
    if args.cmd == "show":
        r = buildq.get(conn, args.id)
        if r is None:
            return die(f"no such row {args.id}")
        evs = [dict(x) for x in buildq.events(conn, args.id)]
        if args.as_json:
            print(json.dumps({"row": _row(r), "events": evs}))
        else:
            print(_line(r))
            for x in evs:
                print(f"  {x['ts']}  {x['event']}  {x['detail'] or ''}")
        return 0
    if args.cmd == "cancel":
        prev = buildq.cancel(conn, args.id)
        if prev is None:
            return die(f"no such row {args.id}")
        msg = {"queued": "cancelled", "running": "cancel requested; the dispatcher stops the run"
               }.get(prev, f"nothing to cancel (already {prev})")
        print(json.dumps({"id": args.id, "previous": prev, "result": msg}) if args.as_json else msg)
        return 0
    if args.cmd == "requeue":
        new = buildq.requeue(conn, args.id)
        if new is None:
            return die(f"no such row {args.id}")
        print(json.dumps({"id": new, "requeued_from": args.id}) if args.as_json else f"queued {new}")
        return 0
    if args.cmd == "hosts":
        used = {r[0]: r[1] for r in conn.execute(
            "SELECT exec_host, COUNT(*) FROM build_queue WHERE status='running' GROUP BY exec_host")}
        cache = build_hosts.ProbeCache()
        info = []
        for name, hc in sorted(cfg.hosts.items()):
            data, unreachable = cache.get(hc)
            adm = build_hosts.admit(hc, data)
            info.append({"host": name, "kind": hc.kind, "default": name == cfg.default_host,
                         "concurrency": hc.concurrency, "free_slots": hc.concurrency - used.get(name, 0),
                         "probe": data, "unreachable": unreachable,
                         "admit": adm.ok, "reason": adm.reason})
        if args.as_json:
            print(json.dumps(info))
        else:
            for i in info:
                print(f"{i['host']}  {i['kind']}{' (default)' if i['default'] else ''}  "
                      f"slots {i['free_slots']}/{i['concurrency']}  "
                      f"probe={json.dumps(i['probe'])}  "
                      f"{'UNREACHABLE' if i['unreachable'] else ('admit' if i['admit'] else 'busy: ' + i['reason'])}")
        return 0
    if args.cmd == "ingest":
        import build_dispatcher
        qd = build_dispatcher.build_dispatcher(ws, cfg)
        ids = qd.ingest_inboxes()
        print(json.dumps({"queued": ids}) if args.as_json else f"ingested {len(ids)} brief(s)")
        return 0
    return 2


if __name__ == "__main__":
    sys.exit(main())
