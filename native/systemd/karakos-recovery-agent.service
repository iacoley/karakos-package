[Unit]
Description=Karakos recovery-agent (deterministic ops watchdog, non-LLM)
After=network-online.target karakos-agent-server.service
Wants=network-online.target

[Service]
Type=simple
User=@@KARAKOS_USER@@
Group=@@KARAKOS_USER@@

WorkingDirectory=@@INSTALL_DIR@@
Environment=HOME=@@INSTALL_DIR_PARENT@@
Environment=WORKSPACE_ROOT=@@INSTALL_DIR@@
EnvironmentFile=@@INSTALL_DIR@@/config/.env

ExecStart=@@INSTALL_DIR@@/.venv/bin/python3 @@INSTALL_DIR@@/bin/recovery-agent.py

Restart=always
RestartSec=2
RestartSteps=8
RestartMaxDelaySec=300

# Matches supervisord.conf's stopwaitsecs=15 for [program:recovery-agent].
TimeoutStopSec=15
KillSignal=SIGTERM

# Persistent logging already added 2026-08-10 (logs/recovery-agent.log) —
# this unit's journal output is a second, redundant view of the same
# lifecycle events, not a replacement for that file.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=karakos-recovery-agent

[Install]
WantedBy=multi-user.target
